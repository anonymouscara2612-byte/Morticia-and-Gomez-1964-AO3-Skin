  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 80px;
  height: 92px;
  background-image: url("https://64.media.tumblr.com/64966a343eada28fe91cbb88e9f1e964/1b03c26d0f36c6f2-75/s1280x1920/1bb3d4ea69f8f1384583ca446abf726818ccc142.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " 𝕮𝖆𝖗𝖆 𝖒𝖎𝖆❣  𝕭𝖚𝖇𝖊𝖑𝖊❣ ";
